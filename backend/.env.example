# Atlas-Lite 環境設定範本 —— 複製成 .env 後再改。
#
# 這裡沒有任何 API 金鑰。Atlas-Lite 不呼叫雲端 LLM，全部功能都在你的機器上跑，
# 所以不填任何東西也能完整使用。

# ── Telegram 通知（選用）────────────────────────────────────────
# 設了之後：工作流暫停等人確認、或步驟失敗時會推播到手機，
# 按鈕可以直接決定重試 / 跳過 / 中止，不用回到電腦前。
# 沒設也能用，只是要在網頁上按。
# 這兩個也可以在設定頁填（設定頁的值優先）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 時區 ────────────────────────────────────────────────────────
# 排程（cron / 一次性）用這個時區解讀時間。
TIMEZONE=Asia/Taipei

# ── 資料目錄（選用）─────────────────────────────────────────────
# 資料庫、log、工作流產物都放這底下。留空 = 專案根目錄的 data/。
# 相對路徑視為相對專案根目錄。
ATLASLITE_DATA=

# ── 腳本節點的 Python（選用）────────────────────────────────────
# 腳本節點刻意不用後端自己的 venv —— 你的腳本依賴不該污染編排器的環境。
# 留空 = 用系統 PATH 上第一支 python。要指定就填絕對路徑。
ATLASLITE_PYTHON=

# ── 地端 GUI 定位模型（選用）────────────────────────────────────
# auto = 依可用顯卡記憶體自動選（≥11GB 用 fp16，否則 int4）。
# 也可以在設定頁改。
ATLASLITE_GROUNDING_PRECISION=auto
