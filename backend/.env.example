# Atlas-Lite 環境設定範本 —— 複製成 backend/.env 後再改。
#
# **全部選填**，一個都不填也能完整使用。核心功能（腳本、桌面自動化、
# 條件分支、人工確認、排程、觸發器）不需要任何 API 金鑰。
#
# 唯一會用到雲端的是選用的「描述→OCR」視覺模型，而那個也可以完全跑地端
# （Ollama）。見最下面那一段。
#
# ⚠ .env 已被 .gitignore 排除，不要 commit 進去。

# ── Telegram 通知（選用）────────────────────────────────────────
# 設了之後：工作流暫停等人確認、或步驟失敗時會推播到手機，
# 按鈕可以直接決定重試 / 跳過 / 中止，不用回到電腦前。
# 沒設也能用，只是要在網頁上按。
# 這兩個也可以在設定頁填（設定頁的值優先）。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 時區 ────────────────────────────────────────────────────────
# 排程（cron / 一次性）用這個時區解讀時間。
TIMEZONE=Asia/Taipei

# ── 資料目錄（選用）─────────────────────────────────────────────
# 資料庫、log、工作流產物都放這底下。留空 = 專案根目錄的 data/。
# 相對路徑視為相對專案根目錄。
ATLASLITE_DATA=

# ── 腳本節點的 Python（選用）────────────────────────────────────
# 腳本節點刻意不用後端自己的 venv —— 你的腳本依賴不該污染編排器的環境。
# 留空 = 用系統 PATH 上第一支 python。要指定就填絕對路徑。
ATLASLITE_PYTHON=

# ── 地端 GUI 定位模型（選用外掛）────────────────────────────────
# auto = 依可用顯卡記憶體自動選（≥11GB 用 fp16，否則 int4）。
# 也可以在設定頁改。需要 plugins/vlm_grounding 外掛 + NVIDIA GPU。
ATLASLITE_GROUNDING_PRECISION=auto

# ── 視覺模型（選用，給桌面自動化的「描述→OCR」用）──────────────
# 用途：畫面上的文字是動態的、錄製時不知道會是什麼字（訂單編號、當日日期）。
# 不設 → 面板上那個選項反灰，其他功能完全不受影響。
# 一般建議在設定頁填（有「測試連線」按鈕）；這裡是給無頭機器用的後援。
#
# provider 可填：ollama / openai / groq / gemini / anthropic
#
# 【地端，建議】Ollama —— 不需要金鑰、截圖不出本機。
#   先執行：ollama pull qwen2.5vl:7b
#   ⚠ 模型要選對：實測 qwen2.5vl:7b 讀對 19/20、每次 15 秒；
#     qwen3-vl:8b-instruct 版本較新卻只有 4/8 且慢 3 倍。詳見 README。
# ATLASLITE_VLM_PROVIDER=ollama
# ATLASLITE_VLM_MODEL=qwen2.5vl:7b
#
# 【雲端】會把螢幕截圖上傳給該供應商並依用量計費。
# ATLASLITE_VLM_PROVIDER=openai
# ATLASLITE_VLM_MODEL=gpt-4o-mini

# 金鑰是「每家一把」，用各家官方慣用的變數名。
# 幾家的金鑰可以同時放著，之後在設定頁切供應商就好，不用回來改這裡。
# （跟其他工具共用同一份 .env 也不會打架。）
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
#
# 只用一家、懶得記變數名的話，也可以用這個共用後援。
# ATLASLITE_VLM_API_KEY=
#
# 自架 / 走代理才需要填端點，留空用官方預設。
# ATLASLITE_VLM_BASE_URL=

# ── LLM（選用，給 AI 助手用）────────────────────────────────────
# 不設 → 助手反灰，工作流的錄製與執行完全不受影響。
# 只支援兩家（刻意的 —— 不搬 Atlas 那一整包 langchain 依賴）：
#
# 【地端，建議】Ollama —— 不需要金鑰、**內容不出本機**。
#   先執行：ollama pull qwen3:8b
# ATLASLITE_LLM_PROVIDER=ollama
# ATLASLITE_LLM_MODEL=qwen3:8b
#
# 【華碩內部】AiHub —— 用公司帳號，不必自備各家 API 金鑰。
#   ⚠ AiHub 底下掛了多家模型，只有 gpt-oss 是華碩自建部署；
#     其餘（azure/google/amazon）的請求內容會送到外部廠商。
#     本專案在程式層鎖定 gpt-oss，要放寬得改 engine/llm.py 的白名單。
# ATLASLITE_LLM_PROVIDER=aihub
# ATLASLITE_LLM_MODEL=gpt-oss
# ATLASLITE_LLM_AIHUB_ENV=prod        # prod 正式區 / stage 測試區
# AIHUB_API_KEY=
#
# 自架 / 走代理才需要填端點，留空用內建預設。
# ATLASLITE_LLM_BASE_URL=
